    {
      "heads": [
        "npx"
      ],
      "ecosystem": "npm",
      "unknown_verb": "ignore",
      "head_only": true,
      "acquire": {
        "": {
          "handler": "npx",
          "sample": "npx prettier@3.3.2"
        }
      },
      "inert": [],
      "safe_flags": [
        "-y",
        "--yes",
        "--prefer-online",
        "--prefer-offline",
        "-q",
        "--quiet"
      ],
      "no_acquire_flags": [
        "--no-install",
        "--offline"
      ]
    },
    {
      "heads": [
        "uv"
      ],
      "ecosystem": "pypi",
      "unknown_verb": "deny",
      "globals": {
        "--directory": "deny_cwd",
        "--project": "deny_cwd",
        "-q": "skip",
        "--quiet": "skip",
        "-v": "skip",
        "--verbose": "skip",
        "--offline": "skip",
        "--no-cache": "skip",
        "-n": "skip",
        "--color": "skip+arg",
        "--cache-dir": "skip+arg",
        "--native-tls": "skip",
        "--allow-insecure-host": "deny"
      },
      "env_deny_prefixes": [
        "UV_"
      ],
      "acquire": {
        "add": {
          "handler": "uv_add",
          "sample": "uv add requests==2.32.5"
        },
        "sync": {
          "handler": "uv_sync",
          "sample": "uv sync",
          "note": "installs the locked project including dev groups"
        },
        "run": {
          "handler": "uv_run",
          "sample": "uv run --with rich==13.7.1 script.py"
        },
        "build": {
          "handler": "uv_build",
          "sample": "uv build",
          "note": "fetches build-system.requires and runs the backend"
        }
      },
      "inert": [
        "auth",
        "remove",
        "version",
        "lock",
        "export",
        "tree",
        "format",
        "check",
        "audit",
        "python",
        "venv",
        "publish",
        "workspace",
        "cache",
        "self",
        "help",
        "init",
        "generate-shell-completion"
      ],
      "subtables": {
        "pip": {
          "acquire": {
            "install": {
              "handler": "uv_pip_install",
              "sample": "uv pip install requests==2.32.5"
            },
            "sync": {
              "handler": "uv_pip_sync",
              "sample": "uv pip sync requirements.txt",
              "note": "installs an entire requirements file"
            }
          },
          "inert": [
            "compile",
            "uninstall",
            "freeze",
            "list",
            "show",
            "tree",
            "check"
          ]
        },
        "tool": {
          "acquire": {
            "run": {
              "handler": "uv_tool_run",
              "sample": "uv tool run ruff@0.12.0"
            },
            "install": {
              "handler": "uv_tool_install",
              "sample": "uv tool install ruff==0.12.0"
            },
            "upgrade": {
              "handler": "unsupported",
              "sample": "uv tool upgrade ruff",
              "note": "fetches a newer version of an installed tool"
            }
          },
          "inert": [
            "uninstall",
            "list",
            "dir",
            "update-shell"
          ]
        }
      }
    },
    {
      "heads": [
        "uvx"
      ],
      "ecosystem": "pypi",
      "unknown_verb": "ignore",
      "head_only": true,
      "acquire": {
        "": {
          "handler": "uvx",
          "sample": "uvx ruff@0.12.0"
        }
