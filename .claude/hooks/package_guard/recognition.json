    {
      "heads": [
        "pip"
      ],
      "ecosystem": "pypi",
      "unknown_verb": "deny",
      "note": "_executable folds pip3 and pip3.12 to pip",
      "globals": {
        "-q": "skip",
        "--quiet": "skip",
        "-v": "skip",
        "--verbose": "skip",
        "--isolated": "skip",
        "--no-input": "skip",
        "--disable-pip-version-check": "skip",
        "--python": "skip+arg",
        "--cache-dir": "skip+arg",
        "--index-url": "deny",
        "--extra-index-url": "deny",
        "--no-index": "deny",
        "--trusted-host": "deny",
        "--cert": "deny",
        "--client-cert": "deny"
      },
      "env_deny_prefixes": [
        "PIP_"
      ],
      "acquire": {
        "install": {
          "handler": "pip_install",
          "sample": "pip install requests==2.32.5"
        },
        "download": {
          "handler": "pip_download",
          "sample": "pip download requests==2.32.5",
          "note": "fetches registry artifacts to disk"
        },
        "wheel": {
          "handler": "pip_wheel",
          "sample": "pip wheel requests==2.32.5",
          "note": "fetches AND builds, executing setup.py"
        },
        "config": {
          "handler": "pip_config",
          "sample": "pip config set global.index-url https://x.example/",
          "note": "only setting an index key is refused"
        }
      },
      "inert": [
        "uninstall",
