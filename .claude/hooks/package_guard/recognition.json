  "installers": [
    {
      "heads": [
        "npm"
      ],
      "ecosystem": "npm",
      "normalize": "npm_deref",
      "unknown_verb": "deny",
      "globals": {
        "--prefix": "deny_cwd",
        "-C": "deny_cwd",
        "-w": "deny_cwd",
        "--workspace": "deny_cwd",
        "--workspaces": "deny_cwd",
        "-s": "skip",
        "--silent": "skip",
        "-q": "skip",
        "--quiet": "skip",
        "--no-audit": "skip",
        "--no-fund": "skip",
        "--loglevel": "skip+arg",
        "--registry": "deny",
        "-v": "inert",
        "--version": "inert",
        "-h": "inert",
        "--help": "inert"
      },
      "env_deny_prefixes": [
        "NPM_CONFIG_"
      ],
      "acquire": {
        "install": {
          "handler": "npm_install",
          "sample": "npm install lodash@4.17.21"
        },
        "install-test": {
          "handler": "npm_install",
          "sample": "npm install-test"
        },
        "ci": {
          "handler": "npm_ci",
          "sample": "npm ci"
        },
        "install-ci-test": {
          "handler": "npm_ci",
          "sample": "npm install-ci-test"
        },
        "exec": {
          "handler": "npm_exec",
          "sample": "npm exec prettier@3.3.2"
        },
        "init": {
          "handler": "npm_init",
          "sample": "npm init vite@5.4.11"
        },
        "update": {
          "handler": "npm_update",
          "sample": "npm update",
          "note": "re-resolves dependencies from the registry"
        },
        "dedupe": {
          "handler": "npm_update",
          "sample": "npm dedupe",
          "note": "re-resolves the tree from the registry"
        },
        "audit": {
          "handler": "npm_audit",
          "sample": "npm audit fix",
          "note": "only the 'fix' subcommand installs"
        },
        "link": {
          "handler": "unsupported",
          "sample": "npm link left-pad",
          "note": "npm link <pkg> installs from the registry"
        },
        "explore": {
          "handler": "unsupported",
          "sample": "npm explore x -- sh",
          "note": "opens a subshell inside a package"
        },
        "install-scripts": {
          "handler": "unsupported",
          "sample": "npm install-scripts",
          "note": "executes package-supplied lifecycle scripts"
        },
        "approve-scripts": {
          "handler": "unsupported",
          "sample": "npm approve-scripts",
          "note": "authorises package-supplied lifecycle scripts"
        },
        "rebuild": {
          "handler": "unsupported",
          "sample": "npm rebuild",
          "note": "re-runs install scripts of installed packages"
        },
        "config": {
          "handler": "npm_config",
          "sample": "npm config set registry https://x.example/",
          "note": "only setting a registry key is refused; it redirects every later install"
        },
        "set": {
          "handler": "npm_config",
          "sample": "npm set registry https://x.example/",
          "note": "alias of 'npm config set'"
        }
      },
