  "env_reasons": {
    "source": "changes where {tool} downloads packages from. Package Guard reviews packages from the default registry only: run the command without it, and do not set it another way (export, a config file, a shell startup file)",
    "network": "routes {tool}'s downloads through a mirror, proxy or other TLS trust, so the files may not be the ones Package Guard reviewed: run the command without it",
    "requirements": "adds requirements {tool} would resolve outside the reviewed set: run the command without it and name each package on the command line",
    "retarget": "points {tool} at another project or install location than the one Package Guard reads: run the command without it from the project directory",
    "integrity": "turns off a check {tool} or Package Guard relies on: run the command without it",
    "unknown": "is not on Package Guard's list of known-safe {tool} settings; run the command without it, or ask the user",
    "path": "must be a literal absolute path, such as {name}=/home/agent/venvs/app: no variable, `~`, glob or `..`, and not inside .claude/",
    "config": "moves the configuration files {tool} reads, which can name another registry, index or proxy than the ones Package Guard checked: run the command without it"
  },
